# Copy to .env to override the defaults. Every variable is optional.

# HTTP port, and the public URL used in authorization links (what a browser can reach).
PORT=4010
PUBLIC_URL=http://localhost:4010

# Secret API key, sent as "Authorization: Bearer <key>".
PAYFLOW_API_KEY=sk_sandbox_9f3c2e7a41b84d6f

# Where webhooks are POSTed: WEBHOOK_BASE_URL + WEBHOOK_PATH, unless WEBHOOK_URL is set.
# docker compose sets WEBHOOK_BASE_URL=http://host.docker.internal:3000.
WEBHOOK_BASE_URL=http://localhost:3000
WEBHOOK_PATH=/webhooks/payflow
# WEBHOOK_URL=http://localhost:3000/webhooks/payflow

# Secret used to sign webhooks (PayFlow-Signature header).
WEBHOOK_SECRET=whsec_sandbox_5d1e8b3a9c7f4026

# Seconds between two state transitions of a mandate or a charge.
SANDBOX_TRANSITION_SECONDS=5

# Seconds per hour of the 72 hour webhook retry schedule. 3600 is real time.
WEBHOOK_RETRY_SECONDS_PER_HOUR=1

# Delays (up to 8s, so events arrive out of order) and duplicates webhook deliveries.
WEBHOOK_CHAOS=false

# Requests per second per API key before 429.
RATE_LIMIT_PER_SECOND=100

# Name shown to the payer on the authorization page.
MERCHANT_NAME=Sandbox merchant

# SQLite file. Defaults to data/payflow.db.
# DATABASE_PATH=data/payflow.db
